{
  "name": "@eosrio/hyperion-wire-plugin",
  "version": "0.0.0-dev.1",
  "private": true,
  "description": "Development Wire protocol primitives for coordinated Hyperion Node and Rust components",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./protocol-profile.json": "./protocol-profile.json"
  },
  "files": ["dist/", "crates/", "Cargo.toml", "Cargo.lock", "protocol-profile.json", "fixtures/", "docs/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "bun check -p tsconfig.json",
    "test": "npm run build && node --test tests/protocol.test.mjs",
    "test:cross": "node scripts/check-cross-language.mjs",
    "test:package": "node scripts/check-package.mjs",
    "check:docs": "python scripts/check-docs.py",
    "prepare": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/eosrio/hyperion-wire-plugin.git" },
  "devDependencies": { "typescript": "7.0.2" }
}
